{
  "name": "@pairspace/api-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && node services/api/node_modules/eslint/bin/eslint.js --config services/api/eslint.config.js services/api packages/domain",
    "test:postgres": "node --test --test-concurrency=1 --test-timeout=30000 tests/postgres/*.integration.mjs",
    "verify:postgres": "bash scripts/run-postgres.sh",
    "test:safety": "node --test tests/postgres/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@embedded-postgres/linux-x64": "18.6.0-beta.19",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "better-auth": "1.7.19",
    "jose": "6.2.17",
    "pg": "8.23.1"
  }
}
